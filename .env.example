# Durable, shared wind-bottles. Provide ONE of these (checked in this order).

# 1) Postgres (recommended; Neon via Vercel Storage has a free plan). Vercel sets this for you when you connect the database.
DATABASE_URL=

# 2) Redis REST (Upstash / Vercel KV)
KV_REST_API_URL=
KV_REST_API_TOKEN=

# With none set, bottles are kept in memory: fine locally, but not shared on Vercel (instances reset).
